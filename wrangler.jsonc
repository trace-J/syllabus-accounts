// Cloudflare configuration for the Syllabus accounts Worker.
//
// Secrets are never here. Put them in with `npx wrangler secret put <NAME>`:
//   GOOGLE_CLIENT_SECRET   the Web OAuth client's secret
//   SESSION_SECRET         signs the browser session cookie; any long random string
//   DRIVE_KEY              encrypts stored Drive refresh tokens; any long random string
//   OPENAI_API_KEY         the transcription key /proxy spends on a user's behalf
//   ANTHROPIC_API_KEY      the summary key /proxy spends on a user's behalf
// For local dev, the same names go in .dev.vars, which is gitignored.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syllabus-accounts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "account_id": "896f047d297ba60187557f9029f6fbc5",
  "routes": [
    { "pattern": "syllabusaccounts.maincoursemedia.com", "custom_domain": true }
  ],
  // One Durable Object per claimed panel holds that panel's WebSocket and relays
  // browser requests over it (src/panel-relay.ts). SQLite-backed, which every
  // Workers plan allows.
  "durable_objects": {
    "bindings": [{ "name": "PANEL", "class_name": "PanelRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PanelRelay"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syllabus-accounts",
      "database_id": "9ed6731f-6323-4999-9674-0cb898b991aa",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://syllabusaccounts.maincoursemedia.com",
    // The Web OAuth client in Google Cloud project friendly-bazaar-507320-b7, the same
    // project as the Desktop client Syllabus ships for `intake login`, so a Drive grant
    // from either sees the same files (drive.file is scoped to the creating project).
    // A client id is public by design; it appears in every sign-in URL.
    "GOOGLE_CLIENT_ID": "61659290097-hch8n1iihe1jmejt96u35ud6202qgrl1.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}

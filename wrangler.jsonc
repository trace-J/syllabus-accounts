// Cloudflare configuration for the Syllabus accounts Worker.
//
// Secrets are never here. Put them in with `npx wrangler secret put <NAME>`:
//   GOOGLE_CLIENT_SECRET   the Web OAuth client's secret
//   SESSION_SECRET         signs the browser session cookie; any long random string
//   DRIVE_KEY              encrypts stored Drive refresh tokens; any long random string
//   OPENAI_API_KEY         the transcription key /proxy falls back to
//   ANTHROPIC_API_KEY      the summary key /proxy spends on a user's behalf
// Optional:
//   GROQ_API_KEY           the cheaper transcription key /proxy prefers. Unset
//                          means every transcription goes to OpenAI.
//   STRIPE_WEBHOOK_SECRET  what Stripe signs webhook deliveries with. Unset
//                          means /stripe/webhook refuses every delivery.
//   STRIPE_SECRET_KEY      the Stripe API key. The webhook never spends it;
//                          Checkout and the Billing Portal will.
// For local dev, the same names go in .dev.vars, which is gitignored.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syllabus-accounts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "account_id": "896f047d297ba60187557f9029f6fbc5",
  "routes": [
    { "pattern": "syllabusaccounts.maincoursemedia.com", "custom_domain": true }
  ],
  // One Durable Object per claimed panel holds that panel's WebSocket and relays
  // browser requests over it (src/panel-relay.ts). SQLite-backed, which every
  // Workers plan allows.
  "durable_objects": {
    "bindings": [{ "name": "PANEL", "class_name": "PanelRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PanelRelay"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "syllabus-accounts",
      "database_id": "9ed6731f-6323-4999-9674-0cb898b991aa",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://syllabusaccounts.maincoursemedia.com",
    // The Web OAuth client in Google Cloud project friendly-bazaar-507320-b7, the same
    // project as the Desktop client Syllabus ships for `intake login`, so a Drive grant
    // from either sees the same files (drive.file is scoped to the creating project).
    // A client id is public by design; it appears in every sign-in URL.
    "GOOGLE_CLIENT_ID": "61659290097-hch8n1iihe1jmejt96u35ud6202qgrl1.apps.googleusercontent.com",
    // Which Stripe price is which tier (src/tiers.ts). A price id is public and
    // appears in a Checkout URL, so these are vars rather than secrets. They
    // live here rather than in the tier table because test mode and live mode
    // have different ids, so these three get swapped when billing goes live.
    //
    // Getting one wrong is quiet rather than loud: an unrecognized price grants
    // Starter, and a SWAPPED pair grants the wrong tier at the right price
    // without anything to notice it. Check them against the amounts in the
    // Stripe dashboard, not against the order they were pasted in.
    "STRIPE_PRICE_STARTER": "price_1UIZmJ1sga9TFYVNoVgeFkvF",
    "STRIPE_PRICE_STANDARD": "price_1UIZmh1sga9TFYVNKLS39XwF",
    "STRIPE_PRICE_PRO": "price_1UIZnK1sga9TFYVNBDt3fkLm",
    // A ONE-TIME price, not a recurring one: 5 more hours for the current
    // month, sold when a cap stops somebody. Empty until it is created, and
    // while it is empty the top-up is simply not offered.
    "STRIPE_PRICE_TOPUP": ""
  },
  "observability": { "enabled": true }
}

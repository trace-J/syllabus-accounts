{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // worker-configuration.d.ts is generated by `wrangler types` (npm run types)
  // and carries the runtime types plus the bindings declared in wrangler.jsonc.
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
